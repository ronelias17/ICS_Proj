# Copy this file to .env before starting the system.
# Replace every CHANGE_ME value with a password chosen for this deployment.

# Optional public HTTPS deployment. Set this only when using docker-compose.https.yml.
DOMAIN=example.com

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME
NEO4J_DATABASE=neo4j

# MongoDB
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=CHANGE_ME
MONGO_DB=ics
MONGO_QUESTION_RECORDS_COLLECTION=question_records
MONGO_SUGGESTIONS_COLLECTION=suggestions

# Local llama.cpp services
LLM_ENDPOINT=http://llama-chat:8080/v1/chat/completions
LLM_MODEL=local-model
EMBEDDING_ENDPOINT=http://llama-embed:8080/v1/embeddings
EMBEDDING_MODEL=embeddinggemma-300M-Q8_0

# GraphRAG runtime
GRAPHRAG_CYPHER_MAX_TOKENS=250
GRAPHRAG_ANSWER_MAX_TOKENS=350
GRAPHRAG_REQUEST_TIMEOUT=90
GRAPHRAG_ANSWER_RETRIES=2
GRAPHRAG_MAX_CONCURRENT_QUESTIONS=1

